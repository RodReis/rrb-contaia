# Ambiente local do ContaIA. Copie para .env antes de subir o Compose.
# Todo valor aqui e sintetico e exclusivo da maquina de desenvolvimento:
# nao existe credencial real, certificado real ou segredo de producao neste arquivo.

COMPOSE_PROJECT_NAME=contaia

# Portas proprias, sem reuso de outro projeto da maquina (ADR-012).
# PORT e a variavel que o Next.js le nativamente (next dev / next start); mantida
# igual a WEB_PORT para as duas formas de rodar a Web baterem na mesma porta:
# `pnpm docker:up` (mapeamento do compose) e `pnpm dev` (processo local).
PORT=15100
WEB_PORT=15100
API_PORT=15101
# Workers e Signer NAO publicam porta (o Signer vive so na rede `privada` do Compose, em 8443,
# alcancavel apenas pelas identidades de servico). WORKERS_PORT e a porta de saude do
# conteiner dos workers, dentro da rede; ninguem a alcanca do host.
WORKERS_PORT=15102
COFRE_PORT=15104
POSTGRES_PORT=15432
REDIS_PORT=16379
KEYCLOAK_PORT=18080
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MAILPIT_SMTP_PORT=11025
MAILPIT_UI_PORT=18025
VAULT_PORT=18200

POSTGRES_DB=contaia
POSTGRES_USER=contaia
POSTGRES_PASSWORD=contaia_local
# Senha do papel `contaia_app` (sem BYPASSRLS) com que API, workers e Signer falam com o banco no
# Compose. O valor e o de desenvolvimento definido na migration 0000; a CI o usa igual.
POSTGRES_APP_PASSWORD=contaia_app_local
DATABASE_URL=postgresql://contaia:contaia_local@127.0.0.1:15432/contaia

# Usuario (uid:gid) com que rodam os conteineres de servico (api, workers, signer, dubles e o
# bootstrap do Vault). Os segredos de teste sao arquivos 0600 do seu usuario: em Linux/CI use o
# resultado de `id -u` / `id -g`; no Docker Desktop (Windows/macOS) o padrao 1000 basta.
CONTAINER_UID=1000
CONTAINER_GID=1000

# Monitor de saude do Signer (SPEC-012 §3.10): a cada 1 minuto. So a prova E2E o encurta
# (ex.: MONITOR_INTERVALO_MS=5000) para provar incidente e recuperacao em segundos.
# MONITOR_INTERVALO_MS=60000

REDIS_URL=redis://127.0.0.1:16379

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_local
KEYCLOAK_REALM=contaia
KEYCLOAK_ISSUER_URL=http://127.0.0.1:18080/realms/contaia
# Service account da API para a Admin API do Keycloak (SPEC-007): cria a
# identidade do convidado, define a senha, desabilita e encerra sessoes.
KEYCLOAK_ADMIN_CLIENT_ID=contaia-api-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=contaia-api-admin-local-secret

# Convite por e-mail (SPEC-007): Mailpit captura localmente; entrega externa
# real so existe depois do ultimo MVP.
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
SMTP_FROM=no-reply@contaia.local
MAILPIT_URL=http://127.0.0.1:18025
WEB_PUBLIC_URL=http://127.0.0.1:15100

MINIO_ROOT_USER=contaia_local
MINIO_ROOT_PASSWORD=contaia_local_secret
S3_ENDPOINT=http://127.0.0.1:19000
S3_BUCKET=contaia-documentos

# Cofre local de certificados A1 (SPEC-011 / F11). Valores SINTETICOS de desenvolvimento;
# a CI gera segredos efemeros (`openssl rand -hex 32`) e um Vault descartavel a cada rodada.
# Nenhum destes valores serve fora desta maquina.
#
# Vault local (modo servidor standalone, nunca -dev). O bootstrap (`pnpm docker:up` ou
# `pnpm vault:bootstrap`) cria infra/docker/.vault-local/ com a unseal key, o root token e
# os tokens tecnicos; esse diretorio e ignorado pelo Git. Nao e KMS/HSM nem producao.
VAULT_ADDR=http://127.0.0.1:18200
# Processo apps/cofre e a origem que o navegador usa para enviar o certificado.
COFRE_PUBLIC_URL=http://127.0.0.1:15104
# O navegador so envia o certificado para esta ORIGEM (o Next embute a variavel no build):
# a URL do cofre devolvida pela API e recusada se a origem for outra. Deixe igual a
# COFRE_PUBLIC_URL. Sem ela (nao recomendado) qualquer URL http(s) valida e aceita.
NEXT_PUBLIC_COFRE_URL=http://127.0.0.1:15104
# Interface em que o processo do cofre escuta. Padrao: so loopback. Outro valor (ex.: 0.0.0.0)
# e decisao explicita de exposicao.
COFRE_HOST=127.0.0.1
# Cofre -> API (callbacks internos) e API -> cofre (inutilizar/restaurar).
COFRE_API_URL=http://127.0.0.1:15101
COFRE_URL=http://127.0.0.1:15104
# HMAC do ticket de ingestao (API assina, cofre verifica) e um Bearer POR DIRECAO:
#   COFRE_SERVICE_TOKEN  cofre -> API  (/interno/cofre/*)
#   COFRE_ADMIN_TOKEN    API -> cofre  (/segredos/:ref/inutilizar|restaurar)
# Cada um precisa de 32 bytes ou mais e os dois precisam ser diferentes.
COFRE_TICKET_SECRET=dev-local-ticket-secret-nao-usar-fora-daqui-0001
COFRE_SERVICE_TOKEN=dev-local-service-token-nao-usar-fora-daqui-0002
COFRE_ADMIN_TOKEN=dev-local-admin-token-nao-usar-fora-daqui-0003
# Token write-only do cofre (emitido pelo bootstrap) e raizes ICP-Brasil confiaveis (PEM).
# Em dev a raiz e SINTETICA: `pnpm cofre:pki-teste` a gera. Uma raiz ICP-Brasil real
# colocada neste diretorio passa a valer tambem para certificado real (decisao do PI).
COFRE_VAULT_TOKEN_FILE=infra/docker/.vault-local/token-cofre-ingestao
COFRE_RAIZES_ICP_DIR=infra/docker/.vault-local/raizes-icp
# Origens do navegador aceitas no CORS da ingestao (separadas por virgula).
COFRE_ORIGENS_PERMITIDAS=http://127.0.0.1:15100
