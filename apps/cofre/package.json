{
  "name": "@contaia/cofre",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.json && node --env-file-if-exists=../../.env dist/main.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:regras": "vitest run --config vitest.config.mjs"
  },
  "dependencies": {
    "@contaia/domain": "workspace:*",
    "@contaia/shared": "workspace:*",
    "busboy": "^1.6.0",
    "node-forge": "^1.4.0"
  },
  "devDependencies": {
    "@contaia/config": "workspace:*",
    "@types/busboy": "^1.5.4",
    "@types/node": "24.13.5",
    "@types/node-forge": "^1.3.14",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
