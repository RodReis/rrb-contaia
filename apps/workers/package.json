{
  "name": "@contaia/workers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:regras": "vitest run --config vitest.config.mjs"
  },
  "dependencies": {
    "@contaia/shared": "workspace:*"
  },
  "devDependencies": {
    "@contaia/config": "workspace:*",
    "@types/node": "24.13.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
