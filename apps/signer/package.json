{
  "name": "@contaia/signer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:regras": "vitest run --config vitest.config.mjs",
    "test:banco": "vitest run --config vitest.banco.config.mjs"
  },
  "dependencies": {
    "@contaia/db": "workspace:*",
    "@contaia/domain": "workspace:*",
    "@contaia/shared": "workspace:*",
    "@xmldom/xmldom": "0.8.15",
    "node-forge": "^1.4.0",
    "pg": "8.23.0",
    "xml-crypto": "6.3.3"
  },
  "devDependencies": {
    "@contaia/config": "workspace:*",
    "@types/node": "24.13.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "8.23.1"
  }
}
