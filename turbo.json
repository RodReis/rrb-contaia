{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "tsconfig.base.json",
    ".env.example"
  ],
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "PROVA_ESCOPO"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "NEXT_PUBLIC_COFRE_URL"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test:regras": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**",
        "test-results/**"
      ]
    },
    "test:banco": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "REDIS_URL"
      ],
      "outputs": [
        "coverage/**",
        "test-results/**"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "test:tela": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**",
        "test-results/**"
      ]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "env": [
        "DATABASE_URL"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "WEB_PORT",
        "API_PORT",
        "WORKERS_PORT",
        "SIGNER_PORT",
        "COFRE_PORT",
        "VAULT_PORT",
        "VAULT_ADDR",
        "COFRE_PUBLIC_URL",
        "COFRE_API_URL",
        "COFRE_URL",
        "COFRE_TICKET_SECRET",
        "COFRE_SERVICE_TOKEN",
        "COFRE_ADMIN_TOKEN",
        "COFRE_HOST",
        "NEXT_PUBLIC_COFRE_URL",
        "COFRE_VAULT_TOKEN_FILE",
        "COFRE_RAIZES_ICP_DIR",
        "COFRE_ORIGENS_PERMITIDAS",
        "DATABASE_URL",
        "REDIS_URL",
        "KEYCLOAK_ADMIN",
        "KEYCLOAK_ADMIN_PASSWORD",
        "KEYCLOAK_REALM",
        "KEYCLOAK_ISSUER_URL",
        "KEYCLOAK_ADMIN_CLIENT_ID",
        "KEYCLOAK_ADMIN_CLIENT_SECRET",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_FROM",
        "MAILPIT_URL",
        "WEB_PUBLIC_URL",
        "MINIO_ROOT_USER",
        "MINIO_ROOT_PASSWORD",
        "S3_ENDPOINT",
        "S3_BUCKET",
        "WEB_ORIGIN",
        "API_ORIGIN"
      ]
    },
    "db:seed": {
      "cache": false,
      "dependsOn": [
        "^build"
      ],
      "env": [
        "DATABASE_URL",
        "KEYCLOAK_URL",
        "KEYCLOAK_REALM",
        "KEYCLOAK_ADMIN",
        "KEYCLOAK_ADMIN_PASSWORD",
        "SEED_USERNAME",
        "SEED_EMAIL"
      ]
    }
  }
}
