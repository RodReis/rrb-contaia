{
  "extends": "@contaia/config/tsconfig/node.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // O processo filho roda o próprio fonte nos testes (Node 24 remove os tipos): os imports
    // relativos usam `.ts` e o tsc os reescreve para `.js` no dist.
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src/**/*.ts"],
  // `testes/` (construtores e montador) vai para o dist (subpath `@contaia/planilhas/testes`): API e workers
  // montam fixtures com ele nos próprios testes. `testes/esperar.ts` depende do vitest e fica fora.
  "exclude": ["src/**/*.test.ts", "src/testes/esperar.ts", "dist"]
}
