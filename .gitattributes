# Scripts com shebang importados pelos testes do cofre: com CRLF (core.autocrlf no Windows) o
# `#!/usr/bin/env node\r` quebra o parse no Vitest. Ficam sempre em LF.
scripts/gerar-pki-de-teste.mjs text eol=lf
infra/docker/vault/bootstrap.mjs text eol=lf
scripts/gerar-pki-mtls-de-teste.mjs text eol=lf
scripts/preparar-segredos-do-signer.mjs text eol=lf
# Fixtures CSV do plano de contas (SPEC-013) e dos empregados (SPEC-014): BOM, CRLF e Latin-1 SÃO o
# que a prova exercita.
# Sem conversão de fim de linha nem de texto, os bytes do repositório são os do arquivo.
tests/e2e/fixtures/*.csv -text
# Planilhas reais geradas pelo LibreOffice (SPEC-015): bytes exatos, sem conversão.
packages/planilhas/fixtures/*.xlsx binary
packages/planilhas/fixtures/*.ods binary
packages/planilhas/fixtures/*.xls binary
packages/planilhas/fixtures/*.csv -text
# XSDs oficiais são mantidos byte a byte, inclusive espaços de documentação do pacote de origem.
packages/shared/src/nfce/schemas/**/*.xsd -text whitespace=-blank-at-eol,-blank-at-eof
